# Copy to .env and fill in. Everything works WITHOUT a key (deterministic MockCritic
# runs automatically), so the demo never depends on live network.

# --- LLM (OpenRouter by default) ---
# Leave OPENROUTER_API_KEY empty to force the offline MockCritic.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Force the mock critic even if a key is set (useful for rehearsals). true/false.
FORCE_MOCK_CRITIC=false

# --- Trust gate freshness thresholds (seconds) ---
FRESH_MAX_SECONDS=120
STALE_MAX_SECONDS=300

# --- Storage ---
# Relative paths resolve against the backend/ directory.
DB_PATH=fleet_harness.db

# --- Action Gateway (Layer 2) ---
# When true, AUTO-tier actions (e.g. create escalation record) execute without
# human approval. HUMAN-tier actions (e.g. halt automation) always wait.
AUTO_APPROVE_AUTO_TIER=true
